.ingredient-selection {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
}

.panel {
    width: 60%;
    height: 70%;
    background-color: rgb(32, 34, 40);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 12px;
    padding: 20px;
    align-items: stretch;
}

.ingredient-list {
    flex-grow: 1;
    margin-bottom: 16px;
}

.ingredient-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.put-back-button {
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(235, 235, 235);
    border-width: 0;
    border-radius: 8px;
    padding: 10px 24px;
    -unity-font-style: bold;
}

.put-back-button:hover {
    background-color: rgba(255, 255, 255, 0.22);
}
