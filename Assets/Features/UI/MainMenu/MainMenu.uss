.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 48px;
}

.buttons {
    align-items: center;
}

.menu-button {
    width: 220px;
    height: 48px;
    margin-bottom: 12px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}
