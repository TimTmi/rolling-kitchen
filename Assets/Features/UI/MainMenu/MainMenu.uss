.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 48px;
}

.buttons {
    flex-direction: row;
    align-items: center;
}

.menu-button {
    width: 220px;
    height: 48px;
    margin-bottom: 12px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.mode-buttons {
    display: none;
    align-items: center;
}

.mode-row {
    flex-direction: row;
}

.mode-button {
    width: 220px;
    margin: 0 8px;
    padding: 24px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
}

.mode-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.mode-icon {
    width: 96px;
    height: 96px;
    margin-bottom: 12px;
    background-size: contain;
    background-position: center;
}

.mode-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.mode-sublabel {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
}

.campaign-icon {
    background-image: url("project://database/Assets/Features/UI/map-pinned.svg?fileID=7388822144124034973&guid=8c2d24d052344621a3f1d38688b5db87&type=3#map-pinned");
}

.endless-icon {
    background-image: url("project://database/Assets/Features/UI/infinity.svg?fileID=7388822144124034973&guid=a5b6299dc21442e7bfe602b74838742f&type=3#infinity");
}

.play-icon {
    background-image: url("project://database/Assets/Features/UI/play.svg?fileID=7388822144124034973&guid=14de24f105eb3702eb4dadf2aa713699&type=3#play");
}

.settings-icon {
    background-image: url("project://database/Assets/Features/UI/settings.svg?fileID=7388822144124034973&guid=229c34194646f7c21bc3ff5d3efb0a45&type=3#settings");
}

.exit-icon {
    background-image: url("project://database/Assets/Features/UI/log-out.svg?fileID=7388822144124034973&guid=1b6a91367a66b34e8a881e306e9f0c1b&type=3#log-out");
}

.back-button {
    width: 48px;
    height: 48px;
    margin-top: 24px;
    padding: 14px;
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
    background-size: auto 60%;
    background-position: center;
    background-image: url("project://database/Assets/Features/UI/chevron-left.svg?fileID=7388822144124034973&guid=7298ce957a954d7eb561a8faa9f12126&type=3#chevron-left");
}

.back-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.level-buttons {
    display: none;
    align-items: center;
}

.level-list {
    width: 320px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.level-button {
    width: 64px;
    height: 64px;
    margin: 6px;
    font-size: 24px;
}

.level-button.locked {
    opacity: 0.4;
}

.settings-panel {
    display: none;
    align-items: center;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    margin-right: 16px;
}

.settings-slider {
    width: 260px;
}
