.center {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 24px;
    height: 24px;
}

.crosshair {
    width: 100%;
    height: 100%;
}

.interaction-prompt {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    visibility: hidden;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
