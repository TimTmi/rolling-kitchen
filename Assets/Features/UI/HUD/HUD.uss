.center {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 24px;
    height: 24px;
}

.crosshair {
    width: 100%;
    height: 100%;
}

.interaction-prompt {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    visibility: hidden;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.orders-left-panel {
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(20, 22, 28, 0.75);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 10px;
    align-items: center;
}

.orders-left-counter {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(235, 235, 235);
}
