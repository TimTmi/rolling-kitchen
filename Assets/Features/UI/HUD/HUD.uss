.center {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 24px;
    height: 24px;
}

.crosshair {
    width: 100%;
    height: 100%;
}

.interaction-prompt {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    visibility: hidden;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.top-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.orders-left-panel {
    margin-right: 8px;
    padding: 10px;
    background-color: rgba(20, 22, 28, 0.75);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 10px;
    align-items: center;
}

.orders-left-counter {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(235, 235, 235);
}

.reputation-panel {
    flex-grow: 1;
    padding: 10px;
    background-color: rgba(20, 22, 28, 0.75);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 10px;
    flex-direction: row;
    align-items: center;
}

.reputation-face-angry {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Features/UI/face-angry.svg?fileID=7388822144124034973&guid=cd9135076db089eef98c538a0067a679&type=3#face-angry");
}

.reputation-face-happy {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Features/UI/face-grinning.svg?fileID=7388822144124034973&guid=684fefa70c15d00518079ab6ee0ec89b&type=3#face-grinning");
}

.reputation-bar {
    flex-grow: 1;
    height: 10px;
    margin: 0 8px;
    border-radius: 5px;
    background-color: rgb(190, 60, 60);
    overflow: hidden;
}

.reputation-fill {
    width: 60%;
    height: 100%;
    background-color: rgb(130, 215, 120);
}
