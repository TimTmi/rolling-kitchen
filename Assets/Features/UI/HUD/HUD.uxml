<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Features/UI/HUD/HUD.uss?fileID=7433441132597879392&amp;guid=3b832a1b13c4cc0c3b1f1abcbe35e420&amp;type=3#HUD"/>
    <Style src="project://database/Assets/Features/UI/OrderTickets/OrderTickets.uss?fileID=7433441132597879392&amp;guid=01195283a7f2ca751a5dd1d538c194b9&amp;type=3#OrderTickets"/>
    <ui:VisualElement name="OrderTicketsRoot" picking-mode="Ignore" class="order-tickets-root">
        <ui:VisualElement name="TopRow" picking-mode="Ignore" class="top-row">
            <ui:VisualElement name="OrdersLeftPanel" picking-mode="Ignore" class="orders-left-panel">
                <ui:Label text="Orders: 0 / 0" name="OrdersLeftCounter" class="orders-left-counter"/>
            </ui:VisualElement>
            <ui:VisualElement name="ReputationPanel" picking-mode="Ignore" class="reputation-panel">
                <ui:Image name="AngryFace" class="reputation-face-angry"/>
                <ui:VisualElement name="ReputationBar" class="reputation-bar">
                    <ui:VisualElement name="ReputationFill" class="reputation-fill"/>
                </ui:VisualElement>
                <ui:Image name="GrinningFace" class="reputation-face-happy"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="OrderTickets" class="order-tickets"/>
    </ui:VisualElement>
    <ui:VisualElement name="Center" class="center" style="flex-grow: 1;">
        <ui:Image name="Crosshair" source="project://database/Assets/Features/UI/HUD/crosshair.png?fileID=2800000&amp;guid=363e54c8f409c9118a2d0d0388b0a52e&amp;type=3#crosshair" class="crosshair"/>
        <ui:Label text="Label" name="InteractionPrompt" enabled="true" class="interaction-prompt"/>
    </ui:VisualElement>
</ui:UXML>
