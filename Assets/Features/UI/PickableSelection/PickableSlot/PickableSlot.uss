.pickable-slot {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    min-width: 140px;
    min-height: 140px;
    border-radius: 8px;
    border-width: 0;
    padding: 8px;
    background-color: transparent;
}

.pickable-slot:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.pickable-slot:active {
    background-color: rgba(255, 255, 255, 0.2);
}

.pickable-image {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.pickable-label {
    color: rgb(235, 235, 235);
    -unity-font-style: bold;
}
