.game-over-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.panel {
    width: 30%;
    height: 35%;
    background-color: rgb(32, 34, 40);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 12px;
    padding: 32px;
    align-items: center;
    justify-content: center;
}

.title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.buttons {
    flex-direction: row;
}

.icon-button {
    width: 48px;
    height: 48px;
    margin: 0 8px;
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
    background-size: auto 60%;
    background-position: center;
}

.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.orders-served {
    font-size: 20px;
    color: rgb(235, 235, 235);
    margin-bottom: 32px;
}

.home-button {
    background-image: url("project://database/Assets/Features/UI/house.svg?fileID=7388822144124034973&guid=98ae33757b0f7edd38a72f2dce931764&type=3#house");
}

.replay-button {
    background-image: url("project://database/Assets/Features/UI/rotate-ccw.svg?fileID=7388822144124034973&guid=6ceb1b816242fcd57a6f6c8e52c0d8b6&type=3#rotate-ccw");
}

.next-level-button {
    background-image: url("project://database/Assets/Features/UI/chevron-right.svg?fileID=7388822144124034973&guid=382a104a9fd20396bb7bccf9df42ed8c&type=3#chevron-right");
    display: none;
}

.unlock-panel {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding: 16px 24px;
    background-color: rgb(32, 34, 40);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 12px;
}

.unlock-icon {
    width: 48px;
    height: 48px;
    margin-right: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.unlock-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.unlock-ok-button {
    margin-left: 24px;
    padding: 8px 16px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
}

.unlock-ok-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}
