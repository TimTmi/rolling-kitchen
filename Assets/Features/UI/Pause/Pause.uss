.pause-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 48px;
}

.buttons {
    flex-direction: row;
    align-items: center;
}

.mode-button {
    width: 220px;
    margin: 0 8px;
    padding: 24px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
}

.mode-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.mode-icon {
    width: 96px;
    height: 96px;
    margin-bottom: 12px;
    background-size: contain;
    background-position: center;
}

.mode-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.continue-icon {
    background-image: url("project://database/Assets/Features/UI/play.svg?fileID=7388822144124034973&guid=14de24f105eb3702eb4dadf2aa713699&type=3#play");
}

.restart-icon {
    background-image: url("project://database/Assets/Features/UI/rotate-ccw.svg?fileID=7388822144124034973&guid=6ceb1b816242fcd57a6f6c8e52c0d8b6&type=3#rotate-ccw");
}

.settings-icon {
    background-image: url("project://database/Assets/Features/UI/settings.svg?fileID=7388822144124034973&guid=229c34194646f7c21bc3ff5d3efb0a45&type=3#settings");
}

.home-icon {
    background-image: url("project://database/Assets/Features/UI/house.svg?fileID=7388822144124034973&guid=98ae33757b0f7edd38a72f2dce931764&type=3#house");
}

.exit-icon {
    background-image: url("project://database/Assets/Features/UI/log-out.svg?fileID=7388822144124034973&guid=1b6a91367a66b34e8a881e306e9f0c1b&type=3#log-out");
}

.menu-button {
    width: 220px;
    height: 48px;
    margin-bottom: 12px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}

.settings-panel {
    display: none;
    align-items: center;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    margin-right: 16px;
}

.settings-slider {
    width: 260px;
}

.back-button {
    width: 48px;
    height: 48px;
    margin-top: 24px;
    padding: 14px;
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 8px;
    background-size: auto 60%;
    background-position: center;
    background-image: url("project://database/Assets/Features/UI/chevron-left.svg?fileID=7388822144124034973&guid=7298ce957a954d7eb561a8faa9f12126&type=3#chevron-left");
}

.back-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
}
