.order-tickets-root {
    position: absolute;
    left: 16px;
    top: 16px;
    bottom: 16px;
    width: 25%;
}

.order-tickets {
    flex-grow: 1;
}

.order-tickets .unity-scroller--horizontal {
    display: none;
}

.ticket {
    background-color: rgba(20, 22, 28, 0.75);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-radius: 10px;
    padding: 10px;
    margin-bottom: 8px;
}

.ticket-tray {
    color: rgb(235, 235, 235);
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 6px;
}

.ticket-dish {
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-radius: 8px;
    padding: 6px;
    margin-bottom: 6px;
}

.ticket-dish-complete {
    border-color: rgb(130, 215, 120);
}

.ticket-complete {
    border-color: rgb(130, 215, 120);
}

.ticket-ingredients {
    flex-direction: row;
    flex-wrap: wrap;
}

.ticket-ingredient {
    width: 32px;
    height: 32px;
    margin-right: 4px;
    opacity: 0.25;
}

.ticket-ingredient-present {
    opacity: 1;
}
